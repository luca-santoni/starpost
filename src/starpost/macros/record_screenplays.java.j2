// Auto-generated by starpost. Records screenplay MOVIES from the open
// simulation. Run via:  starccm+ -batch <this>.java [...] file.sim
//
// SEPARATE macro from extract_all (same reasoning as render_scenes): recording
// goes through OpenGL and the encoder, is heavy, and is only run on demand
// from the Screenplays tab.
//
// Outputs (in {{ output_dir }}):
//   <dataset>-<screenplay>[-<displayers>][-<view>].<ext>       one movie per
//                                                  screenplay (per chosen view)
//   <dataset>-<screenplay>[-<displayers>][-<view>]_poster.png  a poster frame
//   <simname>__media_index.csv  kind,source,name,file,error,displayers,view,poster
//
// SHOW maps each screenplay to record -> the scalar/vector displayers of its
// scene to keep visible; every other scalar/vector displayer in that scene is
// hidden first. VIEW_NAMES are the saved camera views: each screenplay is
// recorded once per view (empty = the screenplay's own/current camera).
//
// The screenplay API's class names shift across releases and a Java compile
// error is fatal to the whole macro, so it is never referenced at compile
// time: the manager comes from Class.forName and the record call is found by
// scanning the screenplay's public methods (invokeRecord). On a mismatch the
// screenplay gets an ERROR row and the run continues.
package macro;

import java.io.*;
import java.lang.reflect.*;
import java.util.*;
import star.common.*;
import star.vis.*;           // Scene, VisView, displayers (not in star.common)

public class record_screenplays extends StarMacro {

    private static final int MOV_WIDTH = {{ width }};
    private static final int MOV_HEIGHT = {{ height }};
    private static final int FPS = {{ fps }};
    private static final String MOV_EXT = "{{ movie_ext }}";  // mp4 | avi | mov
    private static final double QUALITY = {{ quality_factor }};  // 0..1 factor
    // Saved views to record each screenplay from; empty == its own camera.
    private static final String[] VIEW_NAMES = { {{ view_names_java }} };

    // Screenplay -> scalar/vector displayers to keep visible (user-checked).
    private static Map<String, Set<String>> showMap() {
        Map<String, Set<String>> m = new HashMap<>();
        {{ show_map_puts }}
        return m;
    }

    public void execute() {
        Simulation sim = getActiveSimulation();
        String simPath = sim.getSessionPath();
        String simName = new File(simPath).getName().replaceAll("\\.sim$", "");
        String dir = "{{ output_dir }}";
        Map<String, Set<String>> show = showMap();

        String indexPath = dir + File.separator + simName + "__media_index.csv";
        try (PrintWriter idx = new PrintWriter(new FileWriter(indexPath))) {
            idx.println("kind,source,name,file,error,displayers,view,poster");
            for (Object sp : screenplays(sim)) {
                String name = presentationName(sp);
                if (name == null || !show.containsKey(name)) {
                    continue;
                }
                Scene scene = screenplayScene(sp);
                Set<String> visible = show.get(name);
                if (scene != null) {
                    applyVisibility(sim, scene, visible);
                }
                try {
                    if (VIEW_NAMES.length == 0) {
                        recordOne(sim, idx, sp, scene, simName, dir, name,
                            null, visible);
                    } else {
                        for (String view : VIEW_NAMES) {
                            if (scene != null) {
                                applyView(sim, scene, view);
                            }
                            recordOne(sim, idx, sp, scene, simName, dir, name,
                                view, visible);
                        }
                    }
                } finally {
                    // Release this screenplay's scene before the next one.
                    // Best-effort: never let closing abort the run.
                    if (scene != null) {
                        try {
                            scene.close();
                        } catch (Exception ce) {
                            sim.println("starpost: could not close scene for '"
                                + name + "': " + ce.getMessage());
                        }
                    }
                }
            }
        } catch (IOException e) {
            sim.println("starpost: failed to write media index: "
                + e.getMessage());
        }
    }

    // Records one movie of screenplay sp (optionally from saved view viewName)
    // plus a poster frame, and writes the media-index row. A null viewName
    // records from the screenplay's own/current camera.
    private void recordOne(Simulation sim, PrintWriter idx, Object sp,
                           Scene scene, String simName, String dir, String name,
                           String viewName, Set<String> visible) {
        String disp = (visible.size() > 1)
            ? "multiple-fields" : joinNames(visible);
        String dispReadable = String.join(", ", visible);
        String viewStr = (viewName == null) ? "" : viewName;
        String label = name;
        if (!disp.isEmpty()) label += "-" + disp;
        if (viewName != null) label += "-" + viewName;

        String base = sanitizeFile(simName + "-" + label);
        String movie = base + "." + MOV_EXT;
        String poster = base + "_poster.png";
        String moviePath = dir + File.separator + movie;
        String posterPath = dir + File.separator + poster;
        String tail = "," + esc(dispReadable) + "," + esc(viewStr);

        // Poster first: cheap, and useful in the gallery even if the recording
        // itself fails.
        boolean hasPoster = false;
        if (scene != null) {
            try {
                scene.printAndWait(resolvePath(posterPath), 1,
                    MOV_WIDTH, MOV_HEIGHT);
                hasPoster = true;
            } catch (Exception e) {
                sim.println("starpost: failed to render poster for '" + label
                    + "': " + e.getMessage());
            }
        }
        String posterCell = hasPoster ? esc(poster) : "";
        try {
            invokeRecord(sim, sp, scene, resolvePath(moviePath));
            idx.println("movie," + esc(name) + "," + esc(label) + ","
                + esc(movie) + "," + tail + "," + posterCell);
            sim.println("starpost: recorded '" + label + "' -> " + movie);
        } catch (Exception e) {
            sim.println("starpost: failed to record '" + label + "': "
                + e.getMessage());
            idx.println("movie," + esc(name) + "," + esc(label) + ",,ERROR"
                + tail + "," + posterCell);
        }
    }

    // Finds and invokes a record/export/write method reflectively — on the
    // screenplay itself or on a likely recorder sub-object (screenplay director
    // etc.). Candidates are tried movie-ish names first, fewest parameters
    // first; a call only counts as success if the movie file exists
    // afterwards. Every candidate is listed in the failure message (including
    // unfillable ones, and each invocation failure's root cause); when no
    // candidate exists at all, the full public method list of each scanned
    // object is dumped so the log reveals this release's API.
    private void invokeRecord(Simulation sim, Object sp, Scene scene,
                              String path) throws Exception {
        // Targets to scan: the screenplay itself plus common recorder
        // sub-objects reached by no-arg getters.
        List<Object> targets = new ArrayList<>();
        targets.add(sp);
        for (String getter : new String[] {
                "getScreenplayDirector", "getAnimationDirectorBase",
                "getDirector", "getRecorder", "getAnimationDirector" }) {
            Object t = invokeQuiet(sp, getter);
            if (t != null) {
                targets.add(t);
            }
        }
        StringBuilder tried = new StringBuilder();
        // The empirically-verified signature first; the generic name/type
        // scan below stays as the fallback for other releases.
        if (recordKnown(sim, sp, scene, targets, path, tried)) {
            return;
        }
        if (recordFrameLoop(sim, sp, path, tried)) {
            return;
        }
        List<Object[]> candidates = new ArrayList<>();  // {target, method}
        for (Object target : targets) {
            for (Method m : target.getClass().getMethods()) {
                String n = m.getName().toLowerCase();
                // "…frame…" methods are single-frame image exports
                // (exportMovieFrame, writePngMovieFrameImage, …), never movies.
                if (n.contains("frame")) {
                    continue;
                }
                if (n.equals("record") || n.startsWith("export")
                        || n.startsWith("write")) {
                    candidates.add(new Object[] { target, m });
                }
            }
        }
        // Movie-ish names first (record/…movie…/…animation…), then the generic
        // export*/write* pool; within each group, fewest parameters first.
        candidates.sort(Comparator.comparingInt(c -> {
            Method m = (Method) c[1];
            String n = m.getName().toLowerCase();
            boolean movieish = n.equals("record") || n.contains("movie")
                || n.contains("animation");
            return (movieish ? 0 : 1000) + m.getParameterCount();
        }));
        for (Object[] c : candidates) {
            Object target = c[0];
            Method m = (Method) c[1];
            tried.append("\n  ").append(m);
            Object[] args = fillArgs(m.getParameterTypes(), path);
            if (args == null) {
                tried.append("  [unfillable]");
                continue;
            }
            // STAR-CCM+'s hardcopy path aborts when File.canWrite() is false —
            // which it is for any file that doesn't exist yet ("File ... is not
            // writable, hardcopy aborted"). Pre-create an empty target so the
            // writability probe passes; empty stubs are cleaned up again below.
            try {
                new File(path).createNewFile();
            } catch (Exception ce) {
                // best-effort — the candidate may still manage on its own
            }
            try {
                m.invoke(target, args);
                // A candidate may return normally yet not produce the movie
                // (e.g. a single-frame image export was matched): only a
                // non-empty file at the expected path counts as success.
                if (!verifyOutput(path)) {
                    deleteIfEmpty(new File(path));  // no empty stub left behind
                    tried.append("  [no output file]");
                    continue;
                }
                sim.println("starpost: recorded via "
                    + target.getClass().getSimpleName() + "." + m.getName()
                    + "/" + m.getParameterCount());
                return;
            } catch (Exception e) {
                deleteIfEmpty(new File(path));
                tried.append("  [failed: ").append(rootMessage(e)).append("]");
            }
        }
        if (candidates.isEmpty()) {
            for (Object target : targets) {
                tried.append("\n  -- public methods of ")
                    .append(target.getClass().getName()).append(" --");
                for (Method m : target.getClass().getMethods()) {
                    if (m.getDeclaringClass() == Object.class) {
                        continue;
                    }
                    tried.append("\n  ").append(m.getName()).append("(");
                    Class<?>[] ps = m.getParameterTypes();
                    for (int i = 0; i < ps.length; i++) {
                        if (i > 0) tried.append(", ");
                        tried.append(ps[i].getSimpleName());
                    }
                    tried.append(")");
                }
            }
        }
        deleteIfEmpty(new File(path));
        throw new Exception("no usable record/export method found on "
            + sp.getClass().getName() + "; candidates tried:" + tried);
    }

    // Empirically-derived recorder signature (parameter meanings read off the
    // GUI export dialog: Frame Rate / Start Time / Animation Length /
    // Resolution / Movie Type / Use Anti-Aliasing / Use Transparent
    // Background):
    //   record(int width, int height, double frameRate, double startTime,
    //          double animationLength, String file, int movieType,
    //          boolean antiAliasing, boolean transparentBackground)
    // on the screenplay's animation director. The movie-type int is
    // undocumented, so 0 and then 1 are tried, each verified by the output
    // file appearing. Returns true on success; appends diagnostics to tried
    // otherwise.
    private boolean recordKnown(Simulation sim, Object sp, Scene scene,
                                List<Object> targets, String path,
                                StringBuilder tried) {
        // Arm the server-side recorder: it renders whatever scene was marked,
        // and prepareForExport()/setFramesPerSecond() prime it (introspected
        // from star.common.AnimationDirectorBase).
        Object adb = invokeQuiet(sp, "getAnimationDirectorBase");
        if (adb != null) {
            if (scene != null) {
                try {
                    adb.getClass().getMethod("markRecordingScene", Scene.class)
                        .invoke(adb, scene);
                } catch (Exception e) {
                    sim.println("starpost: markRecordingScene unavailable: "
                        + rootMessage(e));
                }
            }
            try {
                adb.getClass().getMethod("setFramesPerSecond", double.class)
                    .invoke(adb, (double) FPS);
            } catch (Exception e) {
                // best-effort
            }
            Object prepared = invokeQuiet(adb, "prepareForExport");
            sim.println("starpost: prepareForExport -> " + prepared);
        }
        double length = probeLength(sim, targets);
        if (length <= 0) {
            tried.append("\n  [known-signature path skipped: no animation "
                + "length getter found]");
            return false;
        }
        double start = 0.0;
        Object st = invokeQuiet(sp, "getPreferredStartTime");
        if (st instanceof Number) {
            start = ((Number) st).doubleValue();
        }
        Class<?>[] sig9 = { int.class, int.class, double.class, double.class,
            double.class, String.class, int.class, boolean.class,
            boolean.class };
        Class<?>[] sig7 = { int.class, int.class, double.class, double.class,
            double.class, String.class, int.class };
        for (Object target : targets) {
            for (Class<?>[] sig : new Class<?>[][] { sig9, sig7 }) {
                Method m;
                try {
                    m = target.getClass().getMethod("record", sig);
                } catch (Exception e) {
                    continue;
                }
                for (int movieType = 0; movieType <= 1; movieType++) {
                    Object[] args = (sig == sig9)
                        ? new Object[] { MOV_WIDTH, MOV_HEIGHT, (double) FPS,
                            start, length, path, movieType, Boolean.TRUE,
                            Boolean.FALSE }
                        : new Object[] { MOV_WIDTH, MOV_HEIGHT, (double) FPS,
                            start, length, path, movieType };
                    tried.append("\n  ").append(m).append(" [movieType=")
                        .append(movieType).append("]");
                    try {
                        new File(path).createNewFile();
                    } catch (Exception ce) {
                        // best-effort — see invokeRecord
                    }
                    try {
                        sim.println("starpost: trying "
                            + target.getClass().getSimpleName() + ".record("
                            + MOV_WIDTH + ", " + MOV_HEIGHT + ", "
                            + (double) FPS + ", " + start + ", " + length
                            + ", file, " + movieType + ", ...)");
                        m.invoke(target, args);
                        if (verifyOutput(path)) {
                            sim.println("starpost: recorded via known "
                                + "signature (movieType=" + movieType + ")");
                            return true;
                        }
                        deleteIfEmpty(new File(path));
                        tried.append("  [no output file]");
                    } catch (Exception e) {
                        deleteIfEmpty(new File(path));
                        tried.append("  [failed: ").append(rootMessage(e))
                            .append("]");
                    }
                }
            }
        }
        return false;
    }

    // The screenplay movie-export protocol as the GUI drives it (introspected
    // from star.screenplay.Screenplay): initializeForMovieExport, then
    // beginMovieExport(file, w, h, fps, magnification, antiAliasing), then one
    // updateAnimation(t) + exportMovieFrame() per frame, then endMovieExport
    // and finalizeMovieExport. Returns true on verified output.
    private boolean recordFrameLoop(Simulation sim, Object sp, String path,
                                    StringBuilder tried) {
        Object director = invokeQuiet(sp, "getScreenplayDirector");
        Object st = invokeQuiet(sp, "getPreferredStartTime");
        Object len = invokeQuiet(sp, "getPreferredAnimationLength");
        if (director == null || !(st instanceof Number)
                || !(len instanceof Number)
                || ((Number) len).doubleValue() <= 0) {
            tried.append("\n  [frame-loop skipped: director/start/length "
                + "unavailable]");
            return false;
        }
        double start = ((Number) st).doubleValue();
        double length = ((Number) len).doubleValue();
        Method begin;
        Method updateAnim;
        Method exportFrame;
        try {
            begin = sp.getClass().getMethod("beginMovieExport", String.class,
                int.class, int.class, double.class, int.class, boolean.class);
            updateAnim = director.getClass().getMethod("updateAnimation",
                double.class);
            exportFrame = sp.getClass().getMethod("exportMovieFrame");
        } catch (Exception e) {
            tried.append("\n  [frame-loop skipped: protocol methods missing: ")
                .append(rootMessage(e)).append("]");
            return false;
        }
        // frames = length * fps + 1, capped defensively.
        int frames = (int) Math.round(length * FPS) + 1;
        if (frames > 100000) {
            tried.append("\n  [frame-loop skipped: implausible frame count "
                + frames + "]");
            return false;
        }
        sim.println("starpost: frame-loop export: " + frames + " frames @ "
            + FPS + " fps, t=" + start + ".." + (start + length));
        try {
            new File(path).createNewFile();
        } catch (Exception ce) {
            // best-effort — see invokeRecord
        }
        try {
            invokeQuiet(sp, "initializeForMovieExport");
            begin.invoke(sp, path, MOV_WIDTH, MOV_HEIGHT, (double) FPS, 1,
                Boolean.TRUE);
            for (int f = 0; f < frames; f++) {
                updateAnim.invoke(director, start + f / (double) FPS);
                Object r = exportFrame.invoke(sp);
                if (f == 0) {
                    sim.println("starpost: first frame exported ("
                        + r + ")");
                }
            }
        } catch (Exception e) {
            tried.append("\n  [frame-loop failed: ").append(rootMessage(e))
                .append("]");
        } finally {
            // Always close the export so the server isn't left mid-record.
            invokeQuiet(sp, "endMovieExport");
            invokeQuiet(sp, "finalizeMovieExport");
        }
        if (verifyOutput(path)) {
            sim.println("starpost: recorded via screenplay frame-loop export");
            return true;
        }
        deleteIfEmpty(new File(path));
        tried.append("\n  [frame-loop: no output file]");
        return false;
    }

    // The screenplay's animation length in seconds, probed via common getters
    // on the screenplay and its director objects (the export dialog calls the
    // field "Animation Length"); <= 0 when none is found.
    private double probeLength(Simulation sim, List<Object> targets) {
        String[] getters = { "getPreferredAnimationLength",
            "getAnimationEndTime", "getAnimationLength", "getDuration",
            "getLength", "getStopTime", "getEndTime" };
        for (Object target : targets) {
            for (String g : getters) {
                Object v = invokeQuiet(target, g);
                if (v instanceof Number) {
                    double d = ((Number) v).doubleValue();
                    if (d > 0) {
                        sim.println("starpost: animation length " + d
                            + " s (via " + g + ")");
                        return d;
                    }
                }
            }
        }
        return -1;
    }

    // A recording only counts when a non-empty regular file exists at path —
    // a directory is rejected (a PNG-frames export creates one, and
    // File.length() is nonzero for directories on most filesystems).
    private boolean verifyOutput(String path) {
        File out = new File(path);
        return out.exists() && !out.isDirectory() && out.length() > 0;
    }

    // The root cause's message for a (possibly wrapped) invocation failure.
    private String rootMessage(Throwable e) {
        Throwable t = e;
        while (t.getCause() != null && t.getCause() != t) {
            t = t.getCause();
        }
        String msg = t.getMessage();
        return (msg == null || msg.isEmpty()) ? t.getClass().getSimpleName() : msg;
    }

    // Removes a zero-length stub left by a failed/aborted record attempt.
    private void deleteIfEmpty(File f) {
        try {
            if (f.exists() && f.length() == 0) {
                f.delete();
            }
        } catch (Exception e) {
            // best-effort cleanup only
        }
    }

    // The argument list for the parameter types, or null when a type can't be
    // filled (or no String/File parameter exists to receive the output path):
    //   String/File  -> the output file path (first such parameter only)
    //   int/long     -> width, height, fps (in positional order, then 0)
    //   float/double -> the QUALITY factor
    //   boolean      -> false
    private Object[] fillArgs(Class<?>[] types, String path) {
        Object[] args = new Object[types.length];
        boolean pathUsed = false;
        int ints = 0;
        int[] intVals = { MOV_WIDTH, MOV_HEIGHT, FPS };
        for (int i = 0; i < types.length; i++) {
            Class<?> t = types[i];
            if ((t == String.class || t == File.class) && !pathUsed) {
                args[i] = (t == File.class) ? new File(path) : (Object) path;
                pathUsed = true;
            } else if (t == int.class || t == Integer.class
                    || t == long.class || t == Long.class) {
                int v = (ints < intVals.length) ? intVals[ints++] : 0;
                args[i] = (t == long.class || t == Long.class)
                    ? (Object) (long) v : (Object) v;
            } else if (t == double.class || t == Double.class) {
                args[i] = QUALITY;
            } else if (t == float.class || t == Float.class) {
                args[i] = (float) QUALITY;
            } else if (t == boolean.class || t == Boolean.class) {
                args[i] = Boolean.FALSE;
            } else {
                return null;  // a type we can't supply
            }
        }
        return pathUsed ? args : null;
    }

    // The sim's screenplays, or an empty list when this release has none.
    private java.util.List<Object> screenplays(Simulation sim) {
        java.util.List<Object> out = new java.util.ArrayList<>();
        try {
            Class<?> mgrClass =
                Class.forName("star.screenplay.ScreenplayManager");
            Object mgr = Simulation.class.getMethod("get", Class.class)
                .invoke(sim, mgrClass);
            Object objs = mgr.getClass().getMethod("getObjects").invoke(mgr);
            for (Object sp : (Iterable<?>) objs) {
                out.add(sp);
            }
        } catch (Exception e) {
            sim.println("starpost: no screenplays found ("
                + e.getMessage() + ")");
        }
        return out;
    }

    // The Scene a screenplay plays, found by probing common accessors on the
    // screenplay and its actors. Returns null when no scene can be resolved.
    private Scene screenplayScene(Object sp) {
        Object scene = firstScene(invokeQuiet(sp, "getScene"));
        if (scene == null) {
            scene = firstScene(invokeQuiet(sp, "getScenes"));
        }
        if (scene == null) {
            Object actors = invokeQuiet(sp, "getActors");
            if (actors instanceof Iterable) {
                for (Object actor : (Iterable<?>) actors) {
                    scene = firstScene(invokeQuiet(actor, "getScene"));
                    if (scene != null) {
                        break;
                    }
                }
            }
        }
        return (scene instanceof Scene) ? (Scene) scene : null;
    }

    // o itself when it is a Scene, else the first Scene inside an Iterable o.
    private Object firstScene(Object o) {
        if (o instanceof Scene) {
            return o;
        }
        if (o instanceof Iterable) {
            for (Object item : (Iterable<?>) o) {
                if (item instanceof Scene) {
                    return item;
                }
            }
        }
        return null;
    }

    // getMethod(name).invoke(o), or null if the method doesn't exist/fails.
    private Object invokeQuiet(Object o, String method) {
        if (o == null) return null;
        try {
            return o.getClass().getMethod(method).invoke(o);
        } catch (Exception e) {
            return null;
        }
    }

    // Joins displayer names with "_" in iteration order (the map uses a
    // LinkedHashSet so this matches the user's selection order).
    private String joinNames(Set<String> names) {
        StringBuilder sb = new StringBuilder();
        for (String n : names) {
            if (sb.length() > 0) {
                sb.append("_");
            }
            sb.append(n);
        }
        return sb.toString();
    }

    private String sanitizeFile(String s) {
        return s.replaceAll("[^A-Za-z0-9._-]", "_");
    }

    // Apply the saved view named viewName to the scene's current view (matched
    // by its reflective name, applied via the VisView base type). Best-effort.
    private void applyView(Simulation sim, Scene s, String viewName) {
        try {
            for (Object o : sim.getViewManager().getObjects()) {
                if (viewName.equals(presentationName(o))) {
                    s.getCurrentView().setView((VisView) o);
                    return;
                }
            }
            sim.println("starpost: saved view '" + viewName + "' not found");
        } catch (Exception e) {
            sim.println("starpost: could not apply view '" + viewName
                + "': " + e.getMessage());
        }
    }

    // getPresentationName() via reflection — avoids depending on a concrete
    // class name that differs across releases.
    private String presentationName(Object o) {
        try {
            return String.valueOf(
                o.getClass().getMethod("getPresentationName").invoke(o));
        } catch (Exception e) {
            return null;
        }
    }

    // Hide the scalar/vector displayers NOT in keepVisible by setting their
    // opacity to 0; leave checked ones and all other displayer types alone.
    // The .sim is never saved, so these changes are discarded on exit.
    private void applyVisibility(Simulation sim, Scene s,
                                 Set<String> keepVisible) {
        for (DisplayerBase d : s.getDisplayerManager().getObjects()) {
            boolean isField = (d instanceof ScalarDisplayer)
                || (d instanceof VectorDisplayer);
            if (!isField || keepVisible.contains(d.getPresentationName())) {
                continue;
            }
            try {
                if (d instanceof ScalarDisplayer) {
                    ((ScalarDisplayer) d).setOpacity(0.0);
                } else {
                    ((VectorDisplayer) d).setOpacity(0.0);
                }
            } catch (Exception e) {
                sim.println("starpost: could not hide displayer '"
                    + d.getPresentationName() + "': " + e.getMessage());
            }
        }
    }

    private String esc(String s) {
        if (s == null) return "";
        if (s.contains(",") || s.contains("\"") || s.contains("\n")) {
            return "\"" + s.replace("\"", "\"\"") + "\"";
        }
        return s;
    }
}

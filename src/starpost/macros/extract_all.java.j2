// Auto-generated by starpost. CANONICAL extraction macro: in a SINGLE pass over
// the open simulation (one license checkout) it exports ALL reports AND ALL
// monitor plots. Run via:  starccm+ -batch <this>.java [...] file.sim
//
// Outputs (in {{ output_dir }}):
//   <simname>_reports.csv            sim_file,report,value,units
//   <simname>__plot__<plot>.csv      one X column + one column per series
//                                    (STAR-CCM+ StarPlot.export format)
//   <simname>__plots_index.csv       plot,csv_file   (maps plot name -> file)
//   <simname>__scenes_index.csv      scene,displayer,kind  (scalar/vector only)
//   <simname>__views_index.csv       view            (one saved-view name per row)
//   <simname>__screenplays_index.csv screenplay,scene,displayer,kind
//
// extract-all-then-filter: dump everything here; the GUI filters by the user's
// selection/profile. Per-item try/catch keeps one failure from aborting the run.
package macro;

import java.io.*;
import star.common.*;
import star.base.report.*;   // Report, ReportManager (not in star.common)
import star.vis.*;           // Scene, SceneManager (not in star.common)

public class extract_all extends StarMacro {

    public void execute() {
        Simulation sim = getActiveSimulation();
        String simPath = sim.getSessionPath();
        String simName = new File(simPath).getName().replaceAll("\\.sim$", "");
        String dir = "{{ output_dir }}";

        exportReports(sim, simName, dir);
        exportPlots(sim, simName, dir);
        exportScenes(sim, simName, dir);
        exportViews(sim, simName, dir);
        exportScreenplays(sim, simName, dir);
    }

    // Lists the saved camera views in the .sim (sim-global, from the view
    // manager). The concrete view class name varies by release, so we read each
    // entry's name reflectively rather than casting to a star.* type.
    private void exportViews(Simulation sim, String simName, String dir) {
        String out = dir + File.separator + simName + "__views_index.csv";
        try (PrintWriter w = new PrintWriter(new FileWriter(out))) {
            w.println("view");
            for (Object o : sim.getViewManager().getObjects()) {
                String name = presentationName(o);
                if (name != null) {
                    w.println(esc(name));
                }
            }
        } catch (Exception e) {
            sim.println("starpost: failed to write views index: " + e.getMessage());
        }
    }

    // getPresentationName() via reflection — every STAR-CCM+ object has it, so
    // this avoids depending on a concrete class name that differs across releases.
    private String presentationName(Object o) {
        try {
            return String.valueOf(
                o.getClass().getMethod("getPresentationName").invoke(o));
        } catch (Exception e) {
            return null;
        }
    }

    // Lists the scenes present in the .sim and their scalar/vector displayers
    // (no rendering, so this stays cheap and headless-safe). One row per
    // (scene, displayer, kind); a scene with no scalar/vector displayers still
    // gets a row with empty displayer/kind so it appears in the Scenes tree.
    private void exportScenes(Simulation sim, String simName, String dir) {
        String out = dir + File.separator + simName + "__scenes_index.csv";
        try (PrintWriter w = new PrintWriter(new FileWriter(out))) {
            w.println("scene,displayer,kind");
            for (SceneBase sb : sim.getSceneManager().getObjects()) {
                String scene = sb.getPresentationName();
                if (!(sb instanceof Scene)) {
                    continue;
                }
                boolean any = false;
                // getObjects() is typed as DisplayerBase; narrow with instanceof.
                for (DisplayerBase d : ((Scene) sb).getDisplayerManager().getObjects()) {
                    String kind = null;
                    if (d instanceof ScalarDisplayer) {
                        kind = "scalar";
                    } else if (d instanceof VectorDisplayer) {
                        kind = "vector";
                    }
                    if (kind != null) {
                        w.println(esc(scene) + "," + esc(d.getPresentationName())
                            + "," + kind);
                        any = true;
                    }
                }
                if (!any) {
                    w.println(esc(scene) + ",,");
                }
            }
        } catch (IOException e) {
            sim.println("starpost: failed to write scenes index: " + e.getMessage());
        }
    }

    private void exportReports(Simulation sim, String simName, String dir) {
        String out = dir + File.separator + simName + "_reports.csv";
        try (PrintWriter w = new PrintWriter(new FileWriter(out))) {
            w.println("sim_file,report,value,units");
            for (Report r : sim.getReportManager().getObjects()) {
                String name = r.getPresentationName();
                try {
                    double v = r.getReportMonitorValue();
                    String units = r.getUnits() != null
                        ? r.getUnits().getPresentationName() : "";
                    w.println(esc(simName) + "," + esc(name) + "," + v + "," + esc(units));
                } catch (Exception e) {
                    w.println(esc(simName) + "," + esc(name) + ",ERROR,");
                }
            }
        } catch (IOException e) {
            sim.println("starpost: failed to write reports CSV: " + e.getMessage());
        }
    }

    private void exportPlots(Simulation sim, String simName, String dir) {
        String indexPath = dir + File.separator + simName + "__plots_index.csv";
        try (PrintWriter idx = new PrintWriter(new FileWriter(indexPath))) {
            idx.println("plot,csv_file");
            for (StarPlot p : sim.getPlotManager().getObjects()) {
                String name = p.getPresentationName();
                String safe = name.replaceAll("[^A-Za-z0-9._-]", "_");
                String csv = simName + "__plot__" + safe + ".csv";
                String csvPath = dir + File.separator + csv;
                try {
                    // Exports the plot's displayed datasets: X column + one
                    // column per series (e.g. Continuity, X-momentum, ...).
                    p.export(csvPath, ",");
                    idx.println(esc(name) + "," + esc(csv));
                } catch (Exception e) {
                    sim.println("starpost: failed to export plot '" + name
                        + "': " + e.getMessage());
                    idx.println(esc(name) + ",ERROR");
                }
            }
        } catch (IOException e) {
            sim.println("starpost: failed to write plots index: " + e.getMessage());
        }
    }

    private String esc(String s) {
        if (s == null) return "";
        if (s.contains(",") || s.contains("\"") || s.contains("\n")) {
            return "\"" + s.replace("\"", "\"\"") + "\"";
        }
        return s;
    }

    // Lists the screenplays (animations) in the .sim and, for each, the scene
    // it plays and that scene's scalar/vector displayers. One row per
    // (screenplay, displayer); a screenplay with no such displayers still gets
    // a row with empty displayer/kind so it appears in the Screenplays tree.
    //
    // The screenplay API only exists on recent releases (2022+) and its class
    // names are never referenced at compile time (a compile error is fatal to
    // the whole macro): the manager comes from Class.forName, so on an older
    // release this writes a header-only index and extraction is unaffected.
    private void exportScreenplays(Simulation sim, String simName, String dir) {
        String out = dir + File.separator + simName + "__screenplays_index.csv";
        try (PrintWriter w = new PrintWriter(new FileWriter(out))) {
            w.println("screenplay,scene,displayer,kind");
            for (Object sp : screenplays(sim)) {
                String name = presentationName(sp);
                if (name == null) {
                    continue;
                }
                Scene scene = screenplayScene(sp);
                String sceneName = (scene == null)
                    ? "" : scene.getPresentationName();
                boolean any = false;
                if (scene != null) {
                    for (DisplayerBase d
                            : scene.getDisplayerManager().getObjects()) {
                        String kind = null;
                        if (d instanceof ScalarDisplayer) {
                            kind = "scalar";
                        } else if (d instanceof VectorDisplayer) {
                            kind = "vector";
                        }
                        if (kind != null) {
                            w.println(esc(name) + "," + esc(sceneName) + ","
                                + esc(d.getPresentationName()) + "," + kind);
                            any = true;
                        }
                    }
                }
                if (!any) {
                    w.println(esc(name) + "," + esc(sceneName) + ",,");
                }
            }
        } catch (Exception e) {
            sim.println("starpost: failed to write screenplays index: "
                + e.getMessage());
        }
    }

    // The sim's screenplays, or an empty list when this release has none.
    private java.util.List<Object> screenplays(Simulation sim) {
        java.util.List<Object> out = new java.util.ArrayList<>();
        try {
            Class<?> mgrClass =
                Class.forName("star.screenplay.ScreenplayManager");
            Object mgr = Simulation.class.getMethod("get", Class.class)
                .invoke(sim, mgrClass);
            Object objs = mgr.getClass().getMethod("getObjects").invoke(mgr);
            for (Object sp : (Iterable<?>) objs) {
                out.add(sp);
            }
        } catch (Exception e) {
            sim.println("starpost: no screenplays found ("
                + e.getMessage() + ")");
        }
        return out;
    }

    // The Scene a screenplay plays, found by probing common accessors on the
    // screenplay and its actors (the concrete API differs across releases).
    // Returns null when no scene can be resolved.
    private Scene screenplayScene(Object sp) {
        Object scene = firstScene(invokeQuiet(sp, "getScene"));
        if (scene == null) {
            scene = firstScene(invokeQuiet(sp, "getScenes"));
        }
        if (scene == null) {
            Object actors = invokeQuiet(sp, "getActors");
            if (actors instanceof Iterable) {
                for (Object actor : (Iterable<?>) actors) {
                    scene = firstScene(invokeQuiet(actor, "getScene"));
                    if (scene != null) {
                        break;
                    }
                }
            }
        }
        return (scene instanceof Scene) ? (Scene) scene : null;
    }

    // o itself when it is a Scene, else the first Scene inside an Iterable o.
    private Object firstScene(Object o) {
        if (o instanceof Scene) {
            return o;
        }
        if (o instanceof Iterable) {
            for (Object item : (Iterable<?>) o) {
                if (item instanceof Scene) {
                    return item;
                }
            }
        }
        return null;
    }

    // getMethod(name).invoke(o), or null if the method doesn't exist/fails.
    private Object invokeQuiet(Object o, String method) {
        if (o == null) return null;
        try {
            return o.getClass().getMethod(method).invoke(o);
        } catch (Exception e) {
            return null;
        }
    }
}
